generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                      String          @id @default(cuid())
  name                    String
  contactEmail            String?
  contactPhone            String?
  website                 String?
  shippingAddress         String?
  internalNotes           String          @default("")
  creditLimitUsd          Decimal         @default(0) @db.Decimal(12, 2)
  gemstoneMarkupPct       Decimal         @default(0) @db.Decimal(6, 2)
  labDiamondMarkupPct     Decimal         @default(0) @db.Decimal(6, 2)
  naturalDiamondMarkupPct Decimal         @default(0) @db.Decimal(6, 2)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  users                   User[]
  requests                Request[]
  // IMS: a portal Company doubles as the back-office "Client" (baseline D4).
  brandOwnedItems         InventoryItem[] @relation("BrandOwnedItems")
  reservedItems           InventoryItem[] @relation("ReservedItems")
  clientDocuments         Document[]      @relation("ClientDocuments")
}

enum UserStatus {
  PENDING
  APPROVED
  DECLINED
  DEACTIVATED
}

enum UserRole {
  BUYER
  ADMIN
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?
  location         String?
  referredBy       String?
  status           UserStatus           @default(PENDING)
  role             UserRole             @default(BUYER)
  approvedAt       DateTime?
  companyId        String?
  company          Company?             @relation(fields: [companyId], references: [id])
  emailVerifiedAt  DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  requests         Request[]
  cart             Cart?
  favorites        Favorite[]
  // IMS: audit back-references (documents raised / status changes made by this user).
  documentsCreated Document[]
  statusChanges    ItemStatusHistory[]

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Gemstone {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  sku               String
  varietyRaw        String?
  shapeRaw          String?
  colorRaw          String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  certLab           String?
  certNumber        String?
  certUrl           String?
  imageUrl          String?
  image2Url         String?
  image3Url         String?
  image4Url         String?
  videoUrl          String?
  origin            String?
  treatment         String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  cartItems         CartItem[]
  favorites         Favorite[]

  @@index([sku])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([isAvailable, feedRowIndex, sku])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String    @id @default(cuid())
  cartId     String
  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Restrict)
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  qty        Int       @default(1)
  addedAt    DateTime  @default(now())

  @@unique([cartId, gemstoneId])
  @@unique([cartId, diamondId])
  @@index([cartId])
  @@index([diamondId])
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  addedAt    DateTime  @default(now())

  @@unique([userId, gemstoneId])
  @@unique([userId, diamondId])
  @@index([userId])
  @@index([gemstoneId])
  @@index([diamondId])
}

enum RequestType {
  MEMO
  INVOICE
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RequestItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model Request {
  id           String        @id @default(cuid())
  seq          Int           @unique @default(autoincrement())
  type         RequestType
  status       RequestStatus @default(PENDING)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  note         String?
  internalNote String        @default("")
  externalNote String        @default("")
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  items        RequestItem[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model RequestItem {
  id               String            @id @default(cuid())
  requestId        String
  request          Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  gemstoneId       String?
  snapshotSku      String
  snapshotPriceUsd Decimal           @db.Decimal(12, 2)
  snapshotPayload  Json
  status           RequestItemStatus @default(PENDING)

  @@index([requestId])
}

model Diamond {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  vendor            String
  origin            String
  sku               String
  shapeRaw          String?
  shapeMapped       String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  colorWhite        String?
  fancyColor        String?
  fancyIntensity    String?
  fancyOvertone     String?
  clarity           String?
  clarityRank       Int?
  cutGrade          String?
  polish            String?
  symmetry          String?
  fluorescence      String?
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  depthPct          Decimal?   @db.Decimal(6, 2)
  tablePct          Decimal?   @db.Decimal(6, 2)
  girdle            String?
  culet             String?
  certLab           String?
  certNumber        String?
  certUrl           String?
  treatment         String?
  growthMethod      String?
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  state             String?
  country           String?
  photoUrl          String?
  videoUrl          String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  favorites         Favorite[]
  cartItems         CartItem[]

  @@index([sku])
  @@index([vendor])
  @@index([origin])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([clarityRank])
  @@index([isAvailable, origin, feedRowIndex, sku])
}

model IngestState {
  id            String    @id
  lastFeedMtime DateTime?
  lastRunAt     DateTime  @default(now())
  lastRunStats  Json?
  // Alerting state (A7.4): `alertActive` is true while the feed is in a known-bad
  // state, so we alert on entry + re-alert on a throttle rather than every run;
  // it flips back to false (with a recovery email) once a healthy run lands.
  alertActive   Boolean   @default(false)
  lastAlertAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

// Structured per-run history (A7.5). Previously only the single latest run lived
// in IngestState.lastRunStats, so silent feed gaps were undiagnosable after the
// fact. One row per ingest run; pruned to a rolling window in code.
model IngestRun {
  id                   String   @id @default(cuid())
  status               String // "ok" | "no-files" | "error"
  source               String? // "ftp" | "fallback"
  rowsUpsertedTotal    Int      @default(0)
  rowsParsedTotal      Int      @default(0)
  filesProcessed       Int      @default(0)
  diamondsMarkedStale  Int      @default(0)
  gemstonesMarkedStale Int      @default(0)
  skippedFilesCount    Int      @default(0)
  durationMs           Int      @default(0)
  errorText            String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// IMS — in-house inventory management (Phase H1 schema rebuild).
// Append-only forward migration on top of `remove_ims` (never a revert).
// Design source: docs/phase-h/inventory-schema-baseline.md (7-13 upload
// templates reconciled onto shape B). Consignment is intentionally NOT its own
// status or document — it folds into Memo Out + a variable due-term
// (docs/WORKPLAN.md §1.4, memory: consignment-dropped).
//
// Vocabulary policy: only truly-closed sets are Prisma enums. Open or
// category-divergent lists (Shape, Color, Clarity, Pol/Symm, Fluo, Lab,
// Treatment, Origin, Jewelry Type, Metal, Category, Material Type) live in the
// self-growing `VocabularyValue` table + a forgiving importer, so a per-category
// list can diverge (diamond Lab != gem Lab; jewelry Metal != other Metal) and
// any staffer can add a value. Detail tables store the resolved canonical
// string, mirroring how the feed catalogs (Gemstone/Diamond) store raw strings.
// ============================================================================

enum ItemType {
  STONE
  JEWELRY
  OTHER_MATERIAL
}

enum ItemSubtype {
  SINGLE
  PAIR
  PARCEL
}

enum StoneType {
  NATURAL
  LAB
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  ON_MEMO
  SOLD
  RETURNED
}

enum DocumentType {
  BILL_IN
  MEMO_IN
  BRAND_INVENTORY_IN
  MEMO_OUT
  INVOICE
  PURCHASE_ORDER
  RETURN_MEMO_OUT
  RETURN_MEMO_IN
  BRAND_INVENTORY_OUT
}

enum DocumentStatus {
  OPEN
  CLOSED
  EXPORTED
  BILLED
  VOID
}

enum LineStatus {
  IN_STOCK
  ON_MEMO
  SOLD
  RETURNED
}

// The single standardized supplier entity ("Vendor" == "Supplier"; upstream
// feed providers Fantasy/Skylab/Disons are "feed sources", not Vendors).
model Vendor {
  id                   String          @id @default(cuid())
  name                 String          @unique
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  address              String?
  defaultMemoTermsDays Int? // pre-fills Memo In/Out dueDate (default 7d, extendable ~60d)
  quickbooksId         String?
  notes                String          @default("")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  inventoryItems       InventoryItem[]
  documents            Document[]

  @@index([name])
}

// Core inventory row (one per lot/piece). Category-agnostic; exactly one detail
// row hangs off it per itemType. `status` DERIVES from documents, never uploaded.
model InventoryItem {
  id                  String       @id @default(cuid())
  sku                 String       @unique // RADIIA SKU (auto-generated)
  vendorSku           String? // vendor's own stock number (all 4 tabs)
  itemType            ItemType
  itemSubtype         ItemSubtype? // stones only (= Lot Type)
  status              ItemStatus   @default(IN_STOCK) // set only via documents
  vendorId            String?
  vendor              Vendor?      @relation(fields: [vendorId], references: [id])
  brandOwnerId        String? // brand-consigned goods -> Company (client)
  brandOwner          Company?     @relation("BrandOwnedItems", fields: [brandOwnerId], references: [id])
  reservedForClientId String? // "hold/reserve a stone" -> Company (client)
  reservedForClient   Company?     @relation("ReservedItems", fields: [reservedForClientId], references: [id])
  reservedAt          DateTime?
  visibleOnPortal     Boolean      @default(false) // nothing leaks until flipped
  enteredStockAt      DateTime     @default(now()) // time-in-stock anchor
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  stone         StoneDetail?
  jewelry       JewelryDetail?
  material      OtherMaterialDetail?
  lineItems     DocumentLineItem[]
  statusHistory ItemStatusHistory[]

  @@index([status])
  @@index([itemType])
  @@index([vendorId])
  @@index([brandOwnerId])
  @@index([reservedForClientId])
  @@index([visibleOnPortal])
  @@index([vendorSku])
}

// Diamonds + Gems share one detail shape (discriminated by gemType / naturalOrLab).
model StoneDetail {
  id                  String        @id @default(cuid())
  inventoryItemId     String        @unique
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  gemType             String? // gems: variety (= "Stone Type"); null/"Diamond" for diamonds
  naturalOrLab        StoneType? // diamonds: NATURAL|LAB (= "Stone Type"); optional for gems
  shape               String
  weightCt            Decimal       @db.Decimal(10, 3) // = Carat
  quantity            Int? // parcel running qty
  color               String? // white grade OR gem color name
  fancyColor          String? // diamond fancy hue (split from Color on import)
  fancyIntensity      String?
  fancyOvertone       String?
  clarity             String? // diamonds only
  cutGrade            String? // GIA/IGI auto-populate; not in 7-13 template
  polish              String? // = Pol
  symmetry            String? // = Symm
  fluorescence        String? // = Fluo.
  lengthMm            Decimal?      @db.Decimal(10, 3)
  widthMm             Decimal?      @db.Decimal(10, 3)
  heightMm            Decimal?      @db.Decimal(10, 3) // physical depth (mm) — baseline §7 open Q
  depthPct            Decimal?      @db.Decimal(6, 2) // depth %
  tablePct            Decimal?      @db.Decimal(6, 2)
  girdle              String?
  ratio               Decimal?      @db.Decimal(10, 4) // upload override; else app-computed
  lab                 String? // reference vocab (per-category list)
  certNumber          String?
  certUrl             String? // SERVER-READ-ONLY — never sent to browser
  origin              String? // gems
  treatment           String? // gems
  costPerCt           Decimal?      @db.Decimal(12, 2)
  wholesalePricePerCt Decimal?      @db.Decimal(12, 2)
  totalCost           Decimal?      @db.Decimal(12, 2) // app-computed
  totalWholesalePrice Decimal?      @db.Decimal(12, 2) // app-computed
  photo1Url           String?
  photo2Url           String?
  videoUrl            String?
}

model JewelryDetail {
  id               String        @id @default(cuid())
  inventoryItemId  String        @unique
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  jewelryItemType  String // = Jewelry type (reference vocab)
  itemName         String // = Item name
  description      String?
  quantity         Int // = Qty
  metal            String // = Metal (reference vocab; != other-materials Metal)
  lengthMm         Decimal?      @db.Decimal(10, 3)
  ringSize         String? // = Size (generalized beyond ring size)
  mm               Decimal?      @db.Decimal(10, 3)
  metalWeightGrams Decimal?      @db.Decimal(10, 3) // scrap/melt value; not in template
  productionCost   Decimal       @db.Decimal(12, 2) // = Cost
  wholesalePrice   Decimal?      @db.Decimal(12, 2)
  retailPrice      Decimal?      @db.Decimal(12, 2)
  brand            String?
  certNumber       String?
  photo1Url        String?
  photo2Url        String?
  videoUrl         String?
}

model OtherMaterialDetail {
  id              String        @id @default(cuid())
  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  category        String // two-level: Findings | Mountings (reference vocab)
  subtype         String // = Material type (conditional on category, reference vocab)
  itemName        String // = Item name
  quantity        Int // = Qty
  metalType       String // = Metal (reference vocab; != jewelry Metal list)
  lengthMm        Decimal?      @db.Decimal(10, 3)
  size            String?
  mm              Decimal?      @db.Decimal(10, 3)
  weightGrams     Decimal?      @db.Decimal(10, 3)
  description     String?
  cost            Decimal       @db.Decimal(12, 2) // = Cost
  wholesalePrice  Decimal?      @db.Decimal(12, 2)
  photo1Url       String?
  photo2Url       String?
  videoUrl        String?
}

// Inbound/outbound back-office document. Inbound (Bill In / Memo In) create the
// InventoryItem rows and set ownership; outbound docs (Memo Out / Invoice / PO …)
// carry a documentNumber we mint. Inbound docs use the vendor's own number in
// externalReference and leave documentNumber null.
model Document {
  id                String              @id @default(cuid())
  type              DocumentType
  documentNumber    String?             @unique // only for docs WE originate
  externalReference String? // vendor's own bill/memo number (inbound)
  status            DocumentStatus      @default(OPEN)
  vendorId          String?
  vendor            Vendor?             @relation(fields: [vendorId], references: [id])
  clientId          String?
  client            Company?            @relation("ClientDocuments", fields: [clientId], references: [id])
  issueDate         DateTime            @default(now())
  dueDate           DateTime? // Memo In/Out due-term (default 7d, extendable ~60d)
  discountAmount    Decimal?            @db.Decimal(12, 2)
  notes             String?
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lineItems         DocumentLineItem[]
  statusHistory     ItemStatusHistory[]

  @@index([type])
  @@index([status])
  @@index([vendorId])
  @@index([clientId])
  @@index([externalReference])
}

model DocumentLineItem {
  id              String        @id @default(cuid())
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lineStatus      LineStatus
  quantity        Int?
  caratWeight     Decimal?      @db.Decimal(10, 3)
  unitPrice       Decimal?      @db.Decimal(12, 2)
  totalPrice      Decimal?      @db.Decimal(12, 2)
  discountAmount  Decimal?      @db.Decimal(12, 2)
  clientReference String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([documentId])
  @@index([inventoryItemId])
}

// Full audit trail: item lifecycle status only ever changes through a document.
model ItemStatusHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  previousStatus  ItemStatus?
  newStatus       ItemStatus
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id])
  changedById     String
  changedBy       User          @relation(fields: [changedById], references: [id])
  changedAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([documentId])
}

// Per-type document counters. Each doc type has its own counter starting 1000,
// incremented by 3 (1003, 1006, …) at the service layer; Memo In / Bill In use
// the vendor's number instead so they never draw from a sequence.
model DocumentSequence {
  type      DocumentType @id
  lastValue Int          @default(1000)
}

// Self-growing reference vocabulary (pick-or-add). `kind` names the list
// (e.g. DIAMOND_SHAPE, GEM_COLOR, DIAMOND_LAB, GEM_LAB, JEWELRY_METAL,
// OTHER_METAL, JEWELRY_TYPE, OTHER_CATEGORY, OTHER_MATERIAL_TYPE, FLUORESCENCE,
// TREATMENT, ORIGIN). Any staffer may add a value; the importer/form dedups
// case-insensitively before creating.
model VocabularyValue {
  id        String   @id @default(cuid())
  kind      String
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@index([kind])
}
