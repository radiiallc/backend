generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                      String          @id @default(cuid())
  name                    String
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  website                 String?
  shippingAddress         String?
  internalNotes           String          @default("")
  creditLimitUsd          Decimal         @default(0) @db.Decimal(12, 2)
  gemstoneMarkupPct       Decimal         @default(0) @db.Decimal(6, 2)
  labDiamondMarkupPct     Decimal         @default(0) @db.Decimal(6, 2)
  naturalDiamondMarkupPct Decimal         @default(0) @db.Decimal(6, 2)
  clientStatus            ClientStatus    @default(PENDING)
  defaultMemoTermsDays    Int?
  defaultInvoiceTermsDays Int?
  quickbooksId            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  users                   User[]
  requests                Request[]
  brandOwnedItems         InventoryItem[] @relation("BrandOwnedItems")
  reservedItems           InventoryItem[] @relation("ReservedItems")
  clientDocuments         Document[]      @relation("ClientDocuments")

  @@index([clientStatus])
}

enum UserStatus {
  PENDING
  APPROVED
  DECLINED
  DEACTIVATED
}

enum ClientStatus {
  PENDING
  ACTIVE
  DECLINED
  DEACTIVATED
}

enum UserRole {
  BUYER
  ADMIN
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?
  location         String?
  referredBy       String?
  status           UserStatus           @default(PENDING)
  role             UserRole             @default(BUYER)
  approvedAt       DateTime?
  companyId        String?
  company          Company?             @relation(fields: [companyId], references: [id])
  emailVerifiedAt  DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  requests         Request[]
  cart             Cart?
  favorites        Favorite[]
  documentsCreated Document[]
  statusChanges    ItemStatusHistory[]

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Gemstone {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  sku               String
  varietyRaw        String?
  shapeRaw          String?
  colorRaw          String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  certLab           String?
  certNumber        String?
  certUrl           String?
  imageUrl          String?
  image2Url         String?
  image3Url         String?
  image4Url         String?
  videoUrl          String?
  origin            String?
  treatment         String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  cartItems         CartItem[]
  favorites         Favorite[]

  @@index([sku])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([isAvailable, feedRowIndex, sku])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String    @id @default(cuid())
  cartId     String
  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Restrict)
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  qty        Int       @default(1)
  addedAt    DateTime  @default(now())

  @@unique([cartId, gemstoneId])
  @@unique([cartId, diamondId])
  @@index([cartId])
  @@index([diamondId])
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  addedAt    DateTime  @default(now())

  @@unique([userId, gemstoneId])
  @@unique([userId, diamondId])
  @@index([userId])
  @@index([gemstoneId])
  @@index([diamondId])
}

enum RequestType {
  MEMO
  INVOICE
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RequestItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model Request {
  id           String        @id @default(cuid())
  seq          Int           @unique @default(autoincrement())
  type         RequestType
  status       RequestStatus @default(PENDING)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  note         String?
  internalNote String        @default("")
  externalNote String        @default("")
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  items        RequestItem[]

  convertedDocumentId String?   @unique
  convertedDocument   Document? @relation("RequestConversion", fields: [convertedDocumentId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model RequestItem {
  id               String            @id @default(cuid())
  requestId        String
  request          Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  gemstoneId       String?
  snapshotSku      String
  snapshotPriceUsd Decimal           @db.Decimal(12, 2)
  snapshotPayload  Json
  status           RequestItemStatus @default(PENDING)

  substituteInventoryItemId String?
  substituteInventoryItem   InventoryItem? @relation("SubstituteRequestItems", fields: [substituteInventoryItemId], references: [id])

  @@index([requestId])
  @@index([substituteInventoryItemId])
}

model Diamond {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  vendor            String
  origin            String
  sku               String
  shapeRaw          String?
  shapeMapped       String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  colorWhite        String?
  fancyColor        String?
  fancyIntensity    String?
  fancyOvertone     String?
  clarity           String?
  clarityRank       Int?
  cutGrade          String?
  polish            String?
  symmetry          String?
  fluorescence      String?
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  depthPct          Decimal?   @db.Decimal(6, 2)
  tablePct          Decimal?   @db.Decimal(6, 2)
  girdle            String?
  culet             String?
  certLab           String?
  certNumber        String?
  certUrl           String?
  treatment         String?
  growthMethod      String?
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  state             String?
  country           String?
  photoUrl          String?
  videoUrl          String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  favorites         Favorite[]
  cartItems         CartItem[]

  @@index([sku])
  @@index([vendor])
  @@index([origin])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([clarityRank])
  @@index([isAvailable, origin, feedRowIndex, sku])
}

model IngestState {
  id            String    @id
  lastFeedMtime DateTime?
  lastRunAt     DateTime  @default(now())
  lastRunStats  Json?
  alertActive   Boolean   @default(false)
  lastAlertAt   DateTime?
  consecutiveFailures Int  @default(0)
  updatedAt     DateTime  @updatedAt
}

model IngestRun {
  id                   String   @id @default(cuid())
  status               String
  source               String?
  rowsUpsertedTotal    Int      @default(0)
  rowsParsedTotal      Int      @default(0)
  filesProcessed       Int      @default(0)
  diamondsMarkedStale  Int      @default(0)
  gemstonesMarkedStale Int      @default(0)
  skippedFilesCount    Int      @default(0)
  durationMs           Int      @default(0)
  errorText            String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

enum ItemType {
  STONE
  JEWELRY
  OTHER_MATERIAL
}

enum ItemSubtype {
  SINGLE
  PAIR
  PARCEL
}

enum StoneType {
  NATURAL
  LAB
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  ON_MEMO
  SOLD
  RETURNED
}

enum DocumentType {
  BILL_IN
  MEMO_IN
  BRAND_INVENTORY_IN
  MEMO_OUT
  INVOICE
  PURCHASE_ORDER
  RETURN_MEMO_OUT
  RETURN_MEMO_IN
  BRAND_INVENTORY_OUT
}

enum DocumentStatus {
  OPEN
  CLOSED
  EXPORTED
  BILLED
  VOID
}

enum LineStatus {
  IN_STOCK
  ON_MEMO
  SOLD
  RETURNED
}

enum CloseReason {
  RETURNED
  SOLD
  MIXED
}

model Vendor {
  id                      String          @id @default(cuid())
  name                    String          @unique
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  address                 String?
  defaultMemoTermsDays    Int?
  defaultInvoiceTermsDays Int?
  quickbooksId            String?
  notes                   String          @default("")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  inventoryItems          InventoryItem[]
  documents               Document[]

  @@index([name])
}

model InventoryItem {
  id                  String       @id @default(cuid())
  sku                 String       @unique
  vendorSku           String?
  itemName            String?
  itemType            ItemType
  itemSubtype         ItemSubtype?
  status              ItemStatus   @default(IN_STOCK)
  vendorId            String?
  vendor              Vendor?      @relation(fields: [vendorId], references: [id])
  brandOwnerId        String?
  brandOwner          Company?     @relation("BrandOwnedItems", fields: [brandOwnerId], references: [id])
  reservedForClientId String?
  reservedForClient   Company?     @relation("ReservedItems", fields: [reservedForClientId], references: [id])
  reservedAt          DateTime?
  visibleOnPortal     Boolean      @default(false)
  enteredStockAt      DateTime     @default(now())
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  stone         StoneDetail?
  jewelry       JewelryDetail?
  material      OtherMaterialDetail?
  lineItems     DocumentLineItem[]
  statusHistory ItemStatusHistory[]
  substituteRequestItems RequestItem[] @relation("SubstituteRequestItems")

  @@index([status])
  @@index([itemType])
  @@index([vendorId])
  @@index([brandOwnerId])
  @@index([reservedForClientId])
  @@index([visibleOnPortal])
  @@index([vendorSku])
}

model StoneDetail {
  id                  String        @id @default(cuid())
  inventoryItemId     String        @unique
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  gemType             String?
  naturalOrLab        StoneType?
  shape               String
  weightCt            Decimal       @db.Decimal(10, 3)
  quantity            Int?
  remainingCt         Decimal?      @db.Decimal(10, 3)
  remainingQty        Int?
  color               String?
  fancyColor          String?
  fancyIntensity      String?
  fancyOvertone       String?
  clarity             String?
  cutGrade            String?
  polish              String?
  symmetry            String?
  fluorescence        String?
  lengthMm            Decimal?      @db.Decimal(10, 3)
  widthMm             Decimal?      @db.Decimal(10, 3)
  heightMm            Decimal?      @db.Decimal(10, 3)
  depthPct            Decimal?      @db.Decimal(6, 2)
  tablePct            Decimal?      @db.Decimal(6, 2)
  girdle              String?
  ratio               Decimal?      @db.Decimal(10, 4)
  lab                 String?
  certNumber          String?
  certUrl             String?
  origin              String?
  treatment           String?
  costPerCt           Decimal?      @db.Decimal(12, 2)
  wholesalePricePerCt Decimal?      @db.Decimal(12, 2)
  retailPricePerCt    Decimal?      @db.Decimal(12, 2)
  totalCost           Decimal?      @db.Decimal(12, 2)
  totalWholesalePrice Decimal?      @db.Decimal(12, 2)
  totalRetailPrice    Decimal?      @db.Decimal(12, 2)
  photo1Url           String?
  photo2Url           String?
  videoUrl            String?
}

model JewelryDetail {
  id               String        @id @default(cuid())
  inventoryItemId  String        @unique
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  jewelryItemType  String
  description      String?
  quantity         Int           @default(1)
  remainingQty     Int?
  metal            String?
  lengthMm         Decimal?      @db.Decimal(10, 3)
  ringSize         String?
  mm               Decimal?      @db.Decimal(10, 3)
  metalWeightGrams Decimal?      @db.Decimal(10, 3)
  productionCost   Decimal       @db.Decimal(12, 2)
  wholesalePrice   Decimal?      @db.Decimal(12, 2)
  retailPrice      Decimal?      @db.Decimal(12, 2)
  brand            String?
  certNumber       String?
  photo1Url        String?
  photo2Url        String?
  videoUrl         String?
}

model OtherMaterialDetail {
  id              String        @id @default(cuid())
  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  category        String?
  subtype         String
  quantity        Int           @default(1)
  metalType       String
  lengthMm        Decimal?      @db.Decimal(10, 3)
  size            String?
  mm              Decimal?      @db.Decimal(10, 3)
  weightGrams     Decimal?      @db.Decimal(10, 3)
  description     String?
  cost            Decimal       @db.Decimal(12, 2)
  wholesalePrice  Decimal?      @db.Decimal(12, 2)
  photo1Url       String?
  photo2Url       String?
  videoUrl        String?
}

model Document {
  id                 String              @id @default(cuid())
  type               DocumentType
  documentNumber     String?             @unique
  externalReference  String?
  status             DocumentStatus      @default(OPEN)
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  clientId           String?
  client             Company?            @relation("ClientDocuments", fields: [clientId], references: [id])
  issueDate          DateTime            @default(now())
  dueDate            DateTime?
  discountAmount     Decimal?            @db.Decimal(12, 2)
  notes              String?
  emailedAt          DateTime?
  quickbooksSyncedAt DateTime?
  closeReason        CloseReason?
  parentDocumentId   String?
  parentDocument     Document?           @relation("DocumentReturns", fields: [parentDocumentId], references: [id])
  childDocuments     Document[]          @relation("DocumentReturns")
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lineItems          DocumentLineItem[]  @relation("DocumentLines")
  resolvedLineItems  DocumentLineItem[]  @relation("LineResolutions")
  statusHistory      ItemStatusHistory[]
  sourceRequest      Request?            @relation("RequestConversion")

  @@index([type])
  @@index([status])
  @@index([vendorId])
  @@index([clientId])
  @@index([externalReference])
  @@index([parentDocumentId])
}

model DocumentLineItem {
  id                   String        @id @default(cuid())
  documentId           String
  document             Document      @relation("DocumentLines", fields: [documentId], references: [id], onDelete: Cascade)
  inventoryItemId      String
  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lineStatus           LineStatus
  resolvedByDocumentId String?
  resolvedByDocument   Document?     @relation("LineResolutions", fields: [resolvedByDocumentId], references: [id])
  quantity             Int?
  caratWeight          Decimal?      @db.Decimal(10, 3)
  unitPrice            Decimal?      @db.Decimal(12, 2)
  totalPrice           Decimal?      @db.Decimal(12, 2)
  discountAmount       Decimal?      @db.Decimal(12, 2)
  clientReference      String?
  notes                String?
  createdAt            DateTime      @default(now())

  @@index([documentId])
  @@index([inventoryItemId])
  @@index([resolvedByDocumentId])
}

model ItemStatusHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  previousStatus  ItemStatus?
  newStatus       ItemStatus
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id])
  changedById     String
  changedBy       User          @relation(fields: [changedById], references: [id])
  changedAt       DateTime      @default(now())
  note            String?

  @@index([inventoryItemId])
  @@index([documentId])
}

model DocumentSequence {
  type      DocumentType @id
  lastValue Int          @default(1000)
}

model VocabularyValue {
  id        String   @id @default(cuid())
  kind      String
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@index([kind])
}
