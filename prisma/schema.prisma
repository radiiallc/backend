generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                      String    @id @default(cuid())
  name                    String
  contactEmail            String?
  contactPhone            String?
  website                 String?
  shippingAddress         String?
  internalNotes           String    @default("")
  creditLimitUsd          Decimal   @default(0) @db.Decimal(12, 2)
  gemstoneMarkupPct       Decimal   @default(0) @db.Decimal(6, 2)
  labDiamondMarkupPct     Decimal   @default(0) @db.Decimal(6, 2)
  naturalDiamondMarkupPct Decimal   @default(0) @db.Decimal(6, 2)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  users                   User[]
  requests                Request[]
}

enum UserStatus {
  PENDING
  APPROVED
  DECLINED
  DEACTIVATED
}

enum UserRole {
  BUYER
  ADMIN
  STAFF
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?
  location         String?
  referredBy       String?
  status           UserStatus           @default(PENDING)
  role             UserRole             @default(BUYER)
  approvedAt       DateTime?
  companyId        String?
  company          Company?             @relation(fields: [companyId], references: [id])
  emailVerifiedAt  DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  requests         Request[]
  cart             Cart?
  favorites        Favorite[]
  // IMS (Phase H1) — reuse User for admin/staff (decision D1); no separate AdminUser table.
  clientUsers      ClientUser[]
  createdDocuments Document[]
  statusChanges    ItemStatusHistory[]

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Gemstone {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  sku               String
  varietyRaw        String?
  shapeRaw          String?
  colorRaw          String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  certLab           String?
  certNumber        String?
  certUrl           String?
  imageUrl          String?
  image2Url         String?
  image3Url         String?
  image4Url         String?
  videoUrl          String?
  origin            String?
  treatment         String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  cartItems         CartItem[]
  favorites         Favorite[]

  @@index([sku])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([isAvailable, feedRowIndex, sku])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String    @id @default(cuid())
  cartId     String
  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id])
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id])
  qty        Int       @default(1)
  addedAt    DateTime  @default(now())

  @@unique([cartId, gemstoneId])
  @@unique([cartId, diamondId])
  @@index([cartId])
  @@index([diamondId])
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  diamondId  String?
  diamond    Diamond?  @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  addedAt    DateTime  @default(now())

  @@unique([userId, gemstoneId])
  @@unique([userId, diamondId])
  @@index([userId])
  @@index([gemstoneId])
  @@index([diamondId])
}

enum RequestType {
  MEMO
  INVOICE
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RequestItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model Request {
  id           String        @id @default(cuid())
  seq          Int           @unique @default(autoincrement())
  type         RequestType
  status       RequestStatus @default(PENDING)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  note         String?
  internalNote String        @default("")
  externalNote String        @default("")
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  items        RequestItem[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model RequestItem {
  id               String            @id @default(cuid())
  requestId        String
  request          Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  gemstoneId       String?
  snapshotSku      String
  snapshotPriceUsd Decimal           @db.Decimal(12, 2)
  snapshotPayload  Json
  status           RequestItemStatus @default(PENDING)

  @@index([requestId])
}

model Diamond {
  id                String     @id @default(cuid())
  feedRowId         String     @unique
  feedRowIndex      Int?
  vendor            String
  origin            String
  sku               String
  shapeRaw          String?
  shapeMapped       String?
  weightCt          Decimal?   @db.Decimal(10, 3)
  colorWhite        String?
  fancyColor        String?
  fancyIntensity    String?
  fancyOvertone     String?
  clarity           String?
  clarityRank       Int?
  cutGrade          String?
  polish            String?
  symmetry          String?
  fluorescence      String?
  lengthMm          Decimal?   @db.Decimal(10, 3)
  widthMm           Decimal?   @db.Decimal(10, 3)
  depthMm           Decimal?   @db.Decimal(10, 3)
  ratio             Decimal?   @db.Decimal(10, 4)
  depthPct          Decimal?   @db.Decimal(6, 2)
  tablePct          Decimal?   @db.Decimal(6, 2)
  girdle            String?
  culet             String?
  certLab           String?
  certNumber        String?
  certUrl           String?
  treatment         String?
  growthMethod      String?
  basePricePerCtUsd Decimal?   @db.Decimal(12, 2)
  basePriceUsd      Decimal?   @db.Decimal(12, 2)
  state             String?
  country           String?
  photoUrl          String?
  videoUrl          String?
  rawFeedRow        Json
  lastSeenAt        DateTime   @default(now())
  isAvailable       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  favorites         Favorite[]
  cartItems         CartItem[]

  @@index([sku])
  @@index([vendor])
  @@index([origin])
  @@index([isAvailable])
  @@index([weightCt])
  @@index([feedRowIndex])
  @@index([clarityRank])
  @@index([isAvailable, origin, feedRowIndex, sku])
}

model IngestState {
  id            String    @id
  lastFeedMtime DateTime?
  lastRunAt     DateTime  @default(now())
  lastRunStats  Json?
  // Alerting state (A7.4): `alertActive` is true while the feed is in a known-bad
  // state, so we alert on entry + re-alert on a throttle rather than every run;
  // it flips back to false (with a recovery email) once a healthy run lands.
  alertActive   Boolean   @default(false)
  lastAlertAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

// Structured per-run history (A7.5). Previously only the single latest run lived
// in IngestState.lastRunStats, so silent feed gaps were undiagnosable after the
// fact. One row per ingest run; pruned to a rolling window in code.
model IngestRun {
  id                   String   @id @default(cuid())
  status               String // "ok" | "no-files" | "error"
  source               String? // "ftp" | "fallback"
  rowsUpsertedTotal    Int      @default(0)
  rowsParsedTotal      Int      @default(0)
  filesProcessed       Int      @default(0)
  diamondsMarkedStale  Int      @default(0)
  gemstonesMarkedStale Int      @default(0)
  skippedFilesCount    Int      @default(0)
  durationMs           Int      @default(0)
  errorText            String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// =====================================================================
// Phase H1 — In-house IMS (additive; existing models above untouched).
// Model shape B: InventoryItem core + per-type detail tables (1:1).
// Paths/decisions per docs/phase-h/IMPLEMENTATION_PLAN.md §H1 + field-map.md.
// =====================================================================

// ---- H1.1 Enums ----------------------------------------------------

enum ItemType {
  STONE
  JEWELRY
  OTHER_MATERIAL
}

enum ItemSubtype {
  SINGLE
  PAIR
  PARCEL
}

enum ItemStatus {
  IN_STOCK
  RESERVED // "hold" a stone for a buyer so it can't be double-promised (Jennifer 2026-06-23)
  ON_MEMO
  ON_CONSIGNMENT
  SOLD
  RETURNED
}

// Per-line status on a document line. Mirrors ItemStatus but kept distinct:
// one document can carry lines in mixed states (§H6.1).
enum LineStatus {
  IN_STOCK
  ON_MEMO
  ON_CONSIGNMENT
  SOLD
  RETURNED
}

enum DocumentType {
  BILL_IN
  MEMO_IN
  BRAND_INVENTORY_IN
  MEMO_OUT
  CONSIGNMENT_OUT
  INVOICE
  PURCHASE_ORDER
  RETURN_MEMO_OUT
  RETURN_MEMO_IN
  BRAND_INVENTORY_OUT
}

// Superset across all document types; the valid subset per type is enforced
// in the app layer (docx Table 9), not by the DB.
enum DocumentStatus {
  OPEN
  CLOSED
  EXPORTED
  BILLED
  VOID
}

enum CertLab {
  GIA
  IGI
  NONE
}

// Stone "Type" column (field-map row 25). ✅ Confirmed by Jennifer 2026-06-23:
// diamonds must ALWAYS be clearly distinguished natural vs lab — catalog, detail,
// and documents — "no room for misunderstandings." App layer requires this for
// diamonds; left nullable here because non-diamond gems don't carry it.
enum StoneType {
  NATURAL
  LAB
}

// "Other Materials" subtypes — defined with Jennifer 2026-06-23 (e.g. a
// tennis-bracelet mounting). OTHER is the catch-all; Jennifer may add more later.
enum OtherMaterialSubtype {
  BRACELET_MOUNTING
  EARRING_MOUNTING
  EARRING_BACK
  EARRING_POST
  CLASP
  OTHER
}

// ---- H1.2 Inventory models (shape B) -------------------------------

model InventoryItem {
  id              String       @id @default(cuid())
  sku             String       @unique
  itemType        ItemType
  itemSubtype     ItemSubtype? // stones only (SINGLE / PAIR / PARCEL)
  status          ItemStatus   @default(IN_STOCK)
  vendorId        String?
  vendor          Vendor?      @relation(fields: [vendorId], references: [id])
  brandOwnerId    String? // → Client (brand-inventory owner)
  brandOwner      Client?      @relation("ClientBrandItems", fields: [brandOwnerId], references: [id])
  visibleOnPortal Boolean      @default(false)
  notes           String?

  // Time in stock (Jennifer 2026-06-23): store just the date the item entered
  // stock; "days in stock" is derived for display. No complex aging counters.
  enteredStockAt DateTime @default(now())

  // Hold / reserve (Jennifer 2026-06-23): a buyer request can "hold" a stone so
  // it can't be double-promised. status flips to RESERVED; these record for whom.
  reservedForClientId String?
  reservedForClient   Client?   @relation("ClientReservedItems", fields: [reservedForClientId], references: [id])
  reservedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stoneDetail         StoneDetail?
  jewelryDetail       JewelryDetail?
  otherMaterialDetail OtherMaterialDetail?
  lineItems           DocumentLineItem[]
  statusHistory       ItemStatusHistory[]

  @@index([status])
  @@index([itemType])
  @@index([vendorId])
  @@index([brandOwnerId])
  @@index([reservedForClientId])
  @@index([visibleOnPortal])
}

model StoneDetail {
  id              String        @id @default(cuid())
  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  gemType  String? // gems only
  shape    String?
  weightCt Decimal? @db.Decimal(10, 3)
  quantity Int? // parcel running qty (decrements on partial sale — H6.5)

  color          String?
  fancyColor     String? // diamonds only
  fancyIntensity String? // diamonds only
  fancyOvertone  String? // diamonds only
  clarity        String? // diamonds only
  cutGrade       String? // diamonds only
  polish         String? // diamonds only
  symmetry       String? // diamonds only
  fluorescence   String? // diamonds only

  lengthMm Decimal? @db.Decimal(10, 3)
  widthMm  Decimal? @db.Decimal(10, 3)
  heightMm Decimal? @db.Decimal(10, 3)
  depthPct Decimal? @db.Decimal(6, 2)
  tablePct Decimal? @db.Decimal(6, 2)
  girdle   String?
  ratio    Decimal? @db.Decimal(10, 4) // ⚙️ computeDerived(): lengthMm / widthMm

  lab          CertLab    @default(NONE)
  certNumber   String?
  certUrl      String? // server-side read only (Gate §6.8)
  naturalOrLab StoneType? // ✅ Natural/Lab — always shown for diamonds (Jennifer 2026-06-23)
  origin       String? // gems only; always manual
  treatment    String? // gems only; always manual

  wholesalePricePerCt Decimal? @db.Decimal(12, 2)
  costPerCt           Decimal? @db.Decimal(12, 2)
  totalWholesalePrice Decimal? @db.Decimal(12, 2) // ⚙️ computeDerived(): weightCt × perCt (×qty for parcel)
  totalCost           Decimal? @db.Decimal(12, 2) // ⚙️ computeDerived()

  photo1Url String? // Supabase Storage object path (field-map §5)
  photo2Url String?
  videoUrl  String?
}

model JewelryDetail {
  id              String        @id @default(cuid())
  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  brand           String?
  jewelryItemType String?
  metal           String?
  ringSize        String?
  lengthMm        Decimal? @db.Decimal(10, 3)
  productionCost  Decimal? @db.Decimal(12, 2)
  wholesalePrice  Decimal? @db.Decimal(12, 2)
  retailPrice     Decimal? @db.Decimal(12, 2)
  description     String?
  certNumber      String?
}

// ✅ Fields locked with Jennifer 2026-06-23. Example item: a tennis-bracelet
// mounting. SKU lives on InventoryItem; entry date on InventoryItem.enteredStockAt.
model OtherMaterialDetail {
  id              String        @id @default(cuid())
  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  subtype     OtherMaterialSubtype?
  metalType   String? // "Metal type"
  lengthMm    Decimal?              @db.Decimal(10, 3)
  widthMm     Decimal?              @db.Decimal(10, 3)
  weightGrams Decimal?              @db.Decimal(10, 3) // metal mountings weighed in grams
  quantity    Int?
  description String? // free-form clarification
  cost        Decimal?              @db.Decimal(12, 2) // acquisition cost (for valuation)
}

// ---- H1.3 Parties --------------------------------------------------

model Vendor {
  id                   String          @id @default(cuid())
  name                 String
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  address              String?
  defaultMemoTermsDays Int?
  quickbooksId         String?
  notes                String?
  createdAt            DateTime        @default(now())
  items                InventoryItem[]
  documents            Document[]
}

model Client {
  id               String          @id @default(cuid())
  name             String
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  creditLimit      Decimal?        @db.Decimal(12, 2)
  defaultTermsDays Int?
  quickbooksId     String?
  notes            String?
  createdAt        DateTime        @default(now())
  clientUsers      ClientUser[]
  documents        Document[]
  brandItems       InventoryItem[] @relation("ClientBrandItems")
  reservedItems    InventoryItem[] @relation("ClientReservedItems")
}

// Join Client ↔ existing User (BUYER). The buyer Company concept maps onto Client (D4).
model ClientUser {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}

// ---- H1.4 Documents ------------------------------------------------

model Document {
  id   String       @id @default(cuid())
  type DocumentType

  // We generate a number only for documents WE originate (INVOICE, MEMO_OUT, …)
  // via DocumentSequence. Inbound docs (BILL_IN/MEMO_IN/BRAND_INVENTORY_IN) carry
  // the vendor's own number in externalReference instead — "not ours to assign"
  // (Jennifer 2026-06-23). documentNumber is therefore nullable (NULLs are exempt
  // from the unique constraint in Postgres); externalReference is non-unique
  // (two vendors can both use "Memo 100").
  documentNumber    String?        @unique
  externalReference String?
  status            DocumentStatus @default(OPEN)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  vendorId       String?
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  issueDate      DateTime       @default(now())
  dueDate        DateTime?
  projectJob     String?
  discountAmount Decimal?       @db.Decimal(12, 2)
  notes          String?
  emailedAt      DateTime?
  qboSyncedAt    DateTime?
  qboReferenceId String?

  // invoice → PO (auto-PO, §6.4) and bill → PO links (self-relations).
  linkedPoId      String?
  linkedPo        Document?  @relation("InvoiceToPo", fields: [linkedPoId], references: [id])
  invoicesLinking Document[] @relation("InvoiceToPo")
  billedPoId      String?
  billedPo        Document?  @relation("BillToPo", fields: [billedPoId], references: [id])
  billsLinking    Document[] @relation("BillToPo")

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems     DocumentLineItem[]
  statusHistory ItemStatusHistory[]

  @@index([type, status])
  @@index([clientId])
  @@index([vendorId])
  @@index([dueDate])
}

model DocumentLineItem {
  id              String        @id @default(cuid())
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lineStatus      LineStatus
  quantity        Int?
  caratWeight     Decimal?      @db.Decimal(10, 3)
  unitPrice       Decimal?      @db.Decimal(12, 2)
  totalPrice      Decimal?      @db.Decimal(12, 2)
  discountAmount  Decimal?      @db.Decimal(12, 2)
  clientReference String? // Memo Out / Invoice; carry-over rules §6.5
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([documentId])
  @@index([inventoryItemId])
}

// Every status change goes through a document + a history row (Gate §6.15).
model ItemStatusHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  previousStatus  ItemStatus?
  newStatus       ItemStatus
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id])
  changedById     String
  changedBy       User          @relation(fields: [changedById], references: [id])
  changedAt       DateTime      @default(now())
  notes           String?

  @@index([inventoryItemId])
}

// Per-type monotonic counter for the document numbers WE assign; never resets or
// reuses (Gate §6.16). Incremented under a row lock in a transaction.
//
// Numbering scheme locked with Jennifer 2026-06-23 — START FRESH (do NOT continue
// Fantasy's numbers); human-friendly: start at 1000, increment by 3 (→ 1003, 1006,
// 1009…), with a distinct letter prefix per type. Confirmed prefixes: INV- invoices,
// MEM- memo-out (REQ- requests already exists on Request.seq). Other outbound
// prefixes TBD. Only documents WE originate get a row here; inbound docs use the
// vendor's own number (Document.externalReference). Prefix + step live in app code.
model DocumentSequence {
  type      String   @id // DocumentType value as the key
  lastValue Int      @default(1000) // first issued number = 1000 + step (3) = 1003
  updatedAt DateTime @updatedAt
}
