{
  "name": "radiia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RADIIA standalone backend \u2014 Express API + Prisma. Serves the client portal, admin portal, and future portals. Fully independent of any frontend repo.",
  "scripts": {
    "dev": "dotenv -e .env.dev -- tsx watch src/index.ts",
    "dev:prod": "dotenv -e .env.local -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "migrate:status:dev": "dotenv -e .env.dev -- prisma migrate status",
    "migrate:reset:dev": "dotenv -e .env.dev -- prisma migrate reset",
    "seed:dev": "dotenv -e .env.dev -- tsx prisma/seed.ts",
    "studio:dev": "dotenv -e .env.dev -- prisma studio",
    "migrate:prod": "dotenv -e .env.local -- prisma migrate deploy",
    "migrate:status:prod": "dotenv -e .env.local -- prisma migrate status",
    "seed:prod": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "studio:prod": "dotenv -e .env.local -- prisma studio",
    "migrate:deploy": "prisma migrate deploy",
    "smoke:parcel": "dotenv -e .env.dev -- tsx scripts/parcel-smoke.ts",
    "smoke:restock": "dotenv -e .env.dev -- tsx scripts/restock-smoke.ts",
    "purge:prod": "dotenv -e .env.local -- tsx scripts/inventory-purge.ts",
    "purge:dev": "dotenv -e .env.dev -- tsx scripts/inventory-purge.ts",
    "skylab:fetch": "dotenv -e .env.local -- tsx scripts/skylab-api.ts fetch",
    "skylab:reconcile": "dotenv -e .env.local -- tsx scripts/skylab-api.ts reconcile",
    "smoke:void": "dotenv -e .env.dev -- tsx scripts/void-smoke.ts",
    "smoke:brandin": "dotenv -e .env.dev -- tsx scripts/brand-in-smoke.ts",
    "smoke:jewelry": "dotenv -e .env.dev -- tsx scripts/jewelry-lot-smoke.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "resend": "^6.12.2",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ssh2-sftp-client": "^9.0.6",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.2"
  }
}
