# apps/api — standalone backend env. Copy to apps/api/.env.local and fill.
# During the HR transition the portal's apps/portal/.env.local holds the live
# secrets; the api can read those until its own env is provisioned.

# Server
PORT=4000
NODE_ENV=development

# Data layer (Supabase Postgres via pgbouncer pooler) — pool params are applied
# in @radiia/db; a bare URL is fine here.
DATABASE_URL=
DIRECT_URL=

# Auth (D8: httpOnly cookie shared across *.radiia.co)
AUTH_SECRET=
AUTH_COOKIE_DOMAIN=        # e.g. .radiia.co in prod; empty for host-only in dev

# Inventory media (H3.3) — Supabase Storage for RADIIA-owned photos/videos.
# Optional: leave blank to disable (media endpoints return 503). The bucket MUST
# be PRIVATE — media is served via short-lived signed URLs, never publicly. The
# service-role key is server-only; never expose it to a browser.
SUPABASE_URL=                     # e.g. https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inventory-media

# Service-to-service /internal surface (share page, Sherry feed, cert proxy).
# MUST equal apps/portal INTERNAL_API_SECRET. Empty => /internal fails closed (401).
INTERNAL_API_SECRET=

# Browser origins allowed to call the api with credentials (portal + admin).
# Comma-separated; defaults to the dev portal + dev admin shell. In prod set the
# live portal AND admin origins, e.g.
#   https://stones.radiia.co,https://admin.radiia.co
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RADIIA_NOTIFICATION_EMAIL=

# Ingest cron (moved here in HR-5)
CRON_SECRET=
INGEST_ALERT_THROTTLE_HOURS=6
# Consecutive alert-worthy runs required before the first failure email. The feed
# retries every 15 min, so 2 suppresses blips that fix themselves; 1 = alert on the
# first failed run.
INGEST_ALERT_MIN_CONSECUTIVE_FAILURES=2
GEMSTONE_FTP_HOST=
GEMSTONE_FTP_USER=
GEMSTONE_FTP_PASSWORD=
GEMSTONE_FTP_PATH=
INGEST_FTP_DIR=/upload

# Skylab direct API (FTP->API migration, WORKPLAN §1.6). Only Skylab (lab
# diamonds) moves; Disons + Gemstones stay on FTP. SKYLAB_SOURCE selects the
# Skylab ingest source: "ftp" (default, unchanged behavior) or "api". Flip to
# "api" only after `npm run skylab:reconcile` looks clean. SKYLAB_API_KEY is the
# x-api-key issued by Skylab. SKYLAB_AVAILABLE_STATUSES lists the lot_status
# values that count as live/orderable (comma-separated); confirm with Skylab.
SKYLAB_SOURCE=ftp
SKYLAB_API_URL=https://jwlapi.itemlinkshare.com
SKYLAB_API_PATH=/users/radiia-list
SKYLAB_API_KEY=
SKYLAB_API_TIMEOUT_MS=30000
# Attempts per run (1 initial + retries) for transient Skylab API failures —
# network errors, 5xx, 429. 401 / bad payloads never retry. 1 disables retrying.
SKYLAB_API_RETRY_ATTEMPTS=3
SKYLAB_AVAILABLE_STATUSES=STOCK
# Abort an api-mode Skylab run if usable rows fall below this fraction of the
# currently-available Skylab count (partial-batch guard). Default 0.5.
SKYLAB_MIN_ROWS_FRACTION=0.5

# Sherry outbound feed — the token + markups now live in apps/portal (the CSV is
# built there from the api's /internal/feed/diamonds rows). Nothing to set here.

# GIA Report Results API (IMS ⑤ — grade-report lookup). One GraphQL endpoint
# serves BOTH sandbox and production; the KEY scopes which reports are visible, so
# cutover to live data is a key swap (sandbox key -> production key). Leave
# GIA_API_KEY empty to disable the lookup (it fails closed with a friendly error).
# The key is server-only — never expose it to a browser. Confirm the exact URL from
# GIA's signup email if a call 404s.
GIA_API_ENDPOINT=https://api.reportresults.gia.edu/
GIA_API_KEY=
GIA_API_TIMEOUT_MS=15000
